# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# ── Shopify Storefront API (ver lib/shopify.ts para la guía paso a paso) ──
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=shpat_xxxxxxxxxxxx

# ── WhatsApp Business (formato internacional, sin +) ──────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567

# ── Redes sociales ──────────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_HANDLE=@encantolashes
NEXT_PUBLIC_TIKTOK_HANDLE=@encantolashes

# ── Analítica ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── SEO / sitemap — dominio final del sitio en producción ─────────────
NEXT_PUBLIC_SITE_URL=https://encantolashes.co
